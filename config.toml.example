# ForgeGateway Configuration Example

[server]
host = "0.0.0.0"
port = 8080

[forge_api]
# Base URL for the ForgeCode API
base_url = "https://api.forgecode.com"

# Authentication token (should be set via environment variable in production)
auth_token = "your-auth-token-here"

[logging]
level = "info"
format = "json"

[security]
# CORS settings
allowed_origins = ["*"]
allowed_methods = ["GET", "POST", "PUT", "DELETE"]
allowed_headers = ["*"]

# Rate limiting (requests per minute per IP)
rate_limit = 1000