# Git files
.git
.gitignore
.gitmodules

# Rust build artifacts
target/
**/*.rs.bk

# Cargo files
Cargo.lock

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

